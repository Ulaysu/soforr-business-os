# Copy to .env (git-ignored) and choose your own local password. Never commit .env.
POSTGRES_PASSWORD=change-me
# POSTGRES_PORT=5432

# Only for `docker compose --profile app up --build`: the password of the local development certificate you export (see development.md).
DEV_CERT_PASSWORD=change-me-too
# API_HTTPS_PORT=7443
# API_HTTP_PORT=5080
